<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Espace comité | Made For Bounce</title>
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0d0720">
<style>
:root{color-scheme:dark;--bg:#0d0720;--card:#1b1040;--line:#33225f;--text:#fbf8ff;--muted:#b9afd6;--pink:#ff2e93;--org:#ff8a00;--yel:#ffd23f;--cya:#19d3da}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:radial-gradient(ellipse 70% 40% at 80% 0%,rgba(123,47,247,.35),transparent 70%),var(--bg);color:var(--text);font:400 16px/1.6 "Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0);min-height:100vh}
a{color:var(--cya)}
.wrap{width:min(900px,calc(100% - 32px));margin-inline:auto}
header{border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:12px;height:64px}
.logo{font-weight:800;font-size:1.1rem;text-decoration:none;color:var(--text)}
.logo b{color:var(--pink)}
h1{font-size:clamp(1.8rem,5vw,2.6rem);margin:32px 0 6px;line-height:1.1}
h2{font-size:1.3rem;margin:0 0 14px}
.sub{color:var(--muted);margin:0 0 24px}
.card{background:var(--card);border:2px solid var(--line);border-radius:18px;padding:22px;margin-bottom:16px}
label{display:grid;gap:6px;font-weight:600;font-size:.9rem;margin-bottom:14px}
input,textarea,select{width:100%;padding:12px 14px;border-radius:12px;border:2px solid #3f2f78;background:#120a2e;color:var(--text);font:400 1rem "Segoe UI",system-ui,sans-serif}
input:focus,textarea:focus,select:focus{outline:0;border-color:var(--pink)}
textarea{min-height:110px;resize:vertical}
.btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 22px;border:0;border-radius:999px;background:linear-gradient(135deg,var(--pink),var(--org));color:#fff;font:700 .95rem "Segoe UI",system-ui,sans-serif;cursor:pointer}
.btn.alt{background:transparent;border:2px solid #4b3a86}
.btn.sm{min-height:34px;padding:0 14px;font-size:.82rem}
.btn.red{background:#c0224f}
.btn:disabled{opacity:.5;cursor:not-allowed}
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 20px}
.tabs button{padding:9px 16px;border-radius:999px;border:2px solid var(--line);background:transparent;color:var(--muted);font:600 .9rem "Segoe UI",system-ui,sans-serif;cursor:pointer}
.tabs button.on{background:var(--card);color:var(--text);border-color:var(--pink)}
.msg{margin:10px 0 0;padding:10px 14px;border-radius:10px;font-size:.92rem}
.msg:empty{display:none}
.msg.ok{background:rgba(25,211,218,.14);color:#8ff3f6}
.msg.err{background:rgba(255,46,147,.16);color:#ffb3d4}
.rep h3{margin:0 0 4px;font-size:1.1rem}
.meta{color:var(--muted);font-size:.85rem;margin-bottom:10px}
.rep p{margin:0 0 8px;white-space:pre-wrap}
.rep strong{color:var(--yel);font-size:.85rem}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}
.pill{display:inline-block;padding:2px 10px;border-radius:999px;font-size:.78rem;font-weight:700;background:#2a1a5e}
.pill.g{background:rgba(25,211,218,.2);color:#8ff3f6}
.pill.y{background:rgba(255,210,63,.2);color:var(--yel)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:600px){.two{grid-template-columns:1fr}}
footer{padding:30px 0;color:var(--muted);font-size:.85rem}
</style>
</head>
<body>
<header><div class="wrap nav">
  <a class="logo" href="index.html">Made For <b>Bounce</b></a>
  <div><button class="btn alt sm" id="out" hidden>Déconnexion</button> <a class="btn alt sm" href="index.html" style="text-decoration:none">Retour au site</a></div>
</div></header>

<main class="wrap">

<section class="view" id="vLoad"><h1>Chargement…</h1></section>

<section class="view" id="vAuth" hidden>
  <h1>Espace comité</h1>
  <p class="sub">Connectez-vous pour envoyer vos rapports.</p>
  <div class="card">
    <div class="tabs"><button id="tLogin" class="on" type="button">Connexion</button><button id="tSign" type="button">Créer un compte</button></div>
    <form id="fLogin">
      <label>Email<input id="lMail" type="email" autocomplete="email" required></label>
      <label>Mot de passe<input id="lPass" type="password" autocomplete="current-password" required></label>
      <button class="btn" type="submit">Se connecter</button>
    </form>
    <form id="fSign" hidden>
      <label>Nom complet<input id="sName" type="text" autocomplete="name" required></label>
      <label>Commission<input id="sCom" type="text" placeholder="Ex. Logistique, Sponsoring…" required></label>
      <label>Email<input id="sMail" type="email" autocomplete="email" required></label>
      <label>Mot de passe (8 caractères minimum)<input id="sPass" type="password" minlength="8" autocomplete="new-password" required></label>
      <button class="btn" type="submit">Créer mon compte</button>
    </form>
    <p class="msg" id="aMsg"></p>
  </div>
</section>

<section class="view" id="vWait" hidden>
  <h1>Compte en attente</h1>
  <div class="card"><p>Votre compte est créé. Un administrateur doit le valider avant que vous puissiez envoyer des rapports.</p>
  <button class="btn alt" id="reload" type="button">Vérifier à nouveau</button></div>
</section>

<section class="view" id="vApp" hidden>
  <h1 id="hello">Bonjour</h1>
  <p class="sub" id="who"></p>
  <div class="tabs" id="tabs">
    <button data-t="new" class="on" type="button">Nouveau rapport</button>
    <button data-t="mine" type="button">Mes rapports</button>
    <button data-t="all" type="button" hidden class="adm">Tous les rapports</button>
    <button data-t="mem" type="button" hidden class="adm">Membres</button>
  </div>

  <div class="pane" id="pNew">
    <form class="card" id="fRep">
      <label>Titre<input id="rTitle" type="text" required></label>
      <label>Commission<input id="rCom" type="text" required></label>
      <label>Rapport<textarea id="rContent" required></textarea></label>
      <label>Difficultés<textarea id="rDiff"></textarea></label>
      <label>Prochaines actions<textarea id="rNext"></textarea></label>
      <button class="btn" type="submit">Envoyer le rapport</button>
      <p class="msg" id="rMsg"></p>
    </form>
  </div>
  <div class="pane" id="pMine" hidden><div id="lMine"></div></div>
  <div class="pane" id="pAll" hidden>
    <label>Rechercher<input id="q" type="search" placeholder="Nom, commission, mot…"></label>
    <div id="lAll"></div>
  </div>
  <div class="pane" id="pMem" hidden><div id="lMem"></div></div>
</section>

</main>
<footer><div class="wrap">© Made For Bounce · Cotonou, Bénin</div></footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.0/dist/umd/supabase.min.js"></script>
<script>
(function(){
var sb=supabase.createClient("https://qbxocsylkdbjqqusivfr.supabase.co","sb_publishable_7_USckccQZBBloruIOSoPA_XgODioJl");
var $=function(i){return document.getElementById(i)};
var me=null,allRows=[];
function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function view(id){document.querySelectorAll(".view").forEach(function(v){v.hidden=v.id!==id});$("out").hidden=(id==="vAuth"||id==="vLoad")}
function say(el,t,ok){el.textContent=t;el.className="msg "+(ok?"ok":"err")}
function date(d){return new Date(d).toLocaleDateString("fr-FR",{day:"numeric",month:"long",year:"numeric"})}

async function start(){
  var r=await sb.auth.getSession();
  if(!r.data.session){view("vAuth");return}
  var p=await sb.from("profiles").select("*").eq("id",r.data.session.user.id).single();
  if(p.error||!p.data){view("vAuth");say($("aMsg"),"Profil introuvable. Réessayez dans un instant.",false);return}
  me=p.data;
  if(!me.approved){view("vWait");return}
  $("hello").textContent="Bonjour "+(me.full_name||"");
  $("who").textContent=me.email+(me.role==="admin"?" · Administrateur":"");
  document.querySelectorAll(".adm").forEach(function(b){b.hidden=me.role!=="admin"});
  $("rCom").value=me.commission||"";
  view("vApp");tab("new");
}
function tab(t){
  document.querySelectorAll("#tabs button").forEach(function(b){b.classList.toggle("on",b.dataset.t===t)});
  ["new","mine","all","mem"].forEach(function(k){$("p"+k[0].toUpperCase()+k.slice(1)).hidden=k!==t});
  if(t==="mine")loadMine();if(t==="all")loadAll();if(t==="mem")loadMem();
}
$("tabs").addEventListener("click",function(e){var b=e.target.closest("button");if(b&&!b.hidden)tab(b.dataset.t)});

$("tLogin").onclick=function(){$("fLogin").hidden=false;$("fSign").hidden=true;$("tLogin").className="on";$("tSign").className="";$("aMsg").className="msg"; $("aMsg").textContent=""};
$("tSign").onclick=function(){$("fLogin").hidden=true;$("fSign").hidden=false;$("tSign").className="on";$("tLogin").className="";$("aMsg").className="msg";$("aMsg").textContent=""};

$("fLogin").addEventListener("submit",async function(e){
  e.preventDefault();
  var r=await sb.auth.signInWithPassword({email:$("lMail").value.trim(),password:$("lPass").value});
  if(r.error){say($("aMsg"),"Email ou mot de passe incorrect, ou email pas encore confirmé.",false);return}
  start();
});
$("fSign").addEventListener("submit",async function(e){
  e.preventDefault();
  var r=await sb.auth.signUp({email:$("sMail").value.trim(),password:$("sPass").value,options:{data:{full_name:$("sName").value.trim(),commission:$("sCom").value.trim()}}});
  if(r.error){say($("aMsg"),r.error.message,false);return}
  if(!r.data.session){say($("aMsg"),"Compte créé. Confirmez votre email si on vous le demande, puis connectez-vous. Un administrateur devra ensuite valider votre compte.",true);return}
  start();
});
$("out").onclick=async function(){await sb.auth.signOut();me=null;view("vAuth")};
$("reload").onclick=start;

$("fRep").addEventListener("submit",async function(e){
  e.preventDefault();
  var r=await sb.from("reports").insert({user_id:me.id,title:$("rTitle").value.trim(),commission:$("rCom").value.trim(),content:$("rContent").value.trim(),difficulties:$("rDiff").value.trim(),next_actions:$("rNext").value.trim()});
  if(r.error){say($("rMsg"),"Erreur : "+r.error.message,false);return}
  say($("rMsg"),"Rapport envoyé. Merci !",true);
  $("rTitle").value="";$("rContent").value="";$("rDiff").value="";$("rNext").value="";
});

function repHtml(r,admin){
  var who=admin&&r.profiles?" · "+esc(r.profiles.full_name||"")+" ("+esc(r.profiles.email||"")+")":"";
  return '<article class="card rep"><div class="row"><h3>'+esc(r.title)+'</h3><button class="btn sm red" data-del="'+esc(r.id)+'" type="button">Supprimer</button></div>'+
  '<div class="meta"><span class="pill y">'+esc(r.commission||"—")+'</span> '+date(r.created_at)+who+'</div>'+
  '<p>'+esc(r.content)+'</p>'+
  (r.difficulties?'<p><strong>DIFFICULTÉS</strong><br>'+esc(r.difficulties)+'</p>':"")+
  (r.next_actions?'<p><strong>PROCHAINES ACTIONS</strong><br>'+esc(r.next_actions)+'</p>':"")+'</article>';
}
async function loadMine(){
  var r=await sb.from("reports").select("*").eq("user_id",me.id).order("created_at",{ascending:false});
  $("lMine").innerHTML=r.error?'<p class="msg err">'+esc(r.error.message)+'</p>':(r.data.length?r.data.map(function(x){return repHtml(x,false)}).join(""):'<p class="sub">Aucun rapport pour le moment.</p>');
}
async function loadAll(){
  var r=await sb.from("reports").select("*, profiles(full_name,email)").order("created_at",{ascending:false});
  if(r.error){$("lAll").innerHTML='<p class="msg err">'+esc(r.error.message)+'</p>';return}
  allRows=r.data;drawAll();
}
function drawAll(){
  var q=$("q").value.trim().toLowerCase();
  var rows=allRows.filter(function(x){return !q||JSON.stringify(x).toLowerCase().indexOf(q)>-1});
  $("lAll").innerHTML=rows.length?rows.map(function(x){return repHtml(x,true)}).join(""):'<p class="sub">Aucun rapport.</p>';
}
$("q").addEventListener("input",drawAll);
async function loadMem(){
  var r=await sb.from("profiles").select("*").order("created_at",{ascending:false});
  if(r.error){$("lMem").innerHTML='<p class="msg err">'+esc(r.error.message)+'</p>';return}
  $("lMem").innerHTML=r.data.map(function(m){
    var self=m.id===me.id;
    return '<div class="card"><div class="row"><div><strong>'+esc(m.full_name||"Sans nom")+'</strong><div class="meta">'+esc(m.email)+' · '+esc(m.commission||"—")+'<br>'+
    '<span class="pill '+(m.approved?'g':'y')+'">'+(m.approved?"Validé":"En attente")+'</span> <span class="pill">'+(m.role==="admin"?"Admin":"Membre")+'</span></div></div>'+
    (self?'<span class="meta">C’est vous</span>':'<div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn sm" data-ap="'+esc(m.id)+'" data-v="'+(!m.approved)+'" type="button">'+(m.approved?"Retirer":"Valider")+'</button><button class="btn sm alt" data-ro="'+esc(m.id)+'" data-v="'+(m.role==="admin"?"member":"admin")+'" type="button">'+(m.role==="admin"?"Retirer admin":"Rendre admin")+'</button></div>')+
    '</div></div>';
  }).join("");
}
document.addEventListener("click",async function(e){
  var b=e.target.closest("button");if(!b)return;
  if(b.dataset.del){
    if(!confirm("Supprimer ce rapport ?"))return;
    var r=await sb.from("reports").delete().eq("id",b.dataset.del);
    if(r.error){alert(r.error.message);return}
    if(!$("pMine").hidden)loadMine();else loadAll();
  }
  if(b.dataset.ap){
    var a=await sb.from("profiles").update({approved:b.dataset.v==="true"}).eq("id",b.dataset.ap);
    if(a.error){alert(a.error.message);return}loadMem();
  }
  if(b.dataset.ro){
    if(!confirm("Changer le rôle de ce membre ?"))return;
    var c=await sb.from("profiles").update({role:b.dataset.v}).eq("id",b.dataset.ro);
    if(c.error){alert(c.error.message);return}loadMem();
  }
});
start();
})();
</script>
</body>
</html>
